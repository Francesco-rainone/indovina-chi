# Local SQLite fallback used when TURSO_DATABASE_URL and TURSO_AUTH_TOKEN are absent.
DATABASE_URL=file:./db/custom.db

# Production Turso/libSQL settings.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-token

# Fly.io uses the same public HTTP origin for Next.js and Socket.IO.
# NEXT_PUBLIC_SOCKET_MODE=same-origin
